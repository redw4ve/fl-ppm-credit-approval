# Keeps every generated artifact and every internal working document out of the repository.

# OS, editor and tooling clutter
.DS_Store
.idea/
.vscode/
.pytest_cache/

# Python bytecode and scratch files
__pycache__/
*.py[cod]
*.bak
*.tmp
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Virtual environments, rebuilt from requirements.txt and not relocatable
fl-ppm/
.venv/
venv/

# Raw licensed event logs, fetched by _helpers/download_bpic_from_4tu.py.
# The folder contents are ignored per file so the two OWN_INFO.md dataset notes can ship.
**/BPI Challenge 2017/*
**/BPI Challenge 2012/*
!**/BPI Challenge 2017/OWN_INFO.md
!**/BPI Challenge 2012/OWN_INFO.md
**/*.xes
**/*.xes.gz

# Processed splits and every derived tabular artifact, regenerated by preprocessing
**/data/
**/*.parquet
**/centralized/

# Generated E_04 metadata and the decentralized POC outputs, regenerated by the encoding stage
E_prefix_encoding/encoded_metadata/
E_prefix_encoding/decentralized_poc/

# Generated LLM experiment outputs, regenerated by the encoding stage.
# The two frozen LLM_canonical_schema_*.json inputs sit at the llm_mapping root and are kept.
E_prefix_encoding/mappings/llm_mapping/canonical_schemas/
E_prefix_encoding/mappings/llm_mapping/dataset_mappings/
E_prefix_encoding/mappings/llm_mapping/llm_analysis/

# Derived tensor cache, rebuilt from the processed splits
E_training/prefix_tensor_cache/

# Training outputs and their analyses, produced by the clean run
E_training/training_outputs*/

# Executed notebook copies written beside the frozen sources
**/build/

# Generated figures and run logs
plots/
logs/
**/*.svg

# Internal working documents that never reach the public repository
_decisions/
E_training/_decisions/
E_prefix_encoding/decision.md
_paper/
_paper_artifacts/*.pdf
CLAUDE.md
AGENTS.md

# Archived superseded versions
**/_old/

# Agent configuration folders
.claude/
**/.claude/

# Office lock files, never content
~$*
